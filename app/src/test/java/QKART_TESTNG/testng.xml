<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test case suite e-commerce application">
    <listeners>
        <listener class-name="QKART_TESTNG.ListenerClass" />
    </listeners>
    <test name="Test case execution on Chrome browser">
        <groups>
            <run>
                <include name="Sanity Test" />
                <include name="Regression Test" />
            </run>
        </groups>
        <classes>
            <class name="QKART_TESTNG.QKART_Tests" />
        </classes>
    </test>
</suite>